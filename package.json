{
  "name": "sistema-tickets-soporte",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema full-stack de tickets de soporte con validación de RUT chileno Módulo 11",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run prisma:seed",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
