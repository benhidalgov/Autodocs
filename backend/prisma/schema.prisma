datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  rut          String   @unique
  nombre       String
  departamento String
  email        String
  tickets      Ticket[]
}

model Ticket {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  categoria   String
  prioridad   String   // baja | media | alta | critica
  estado      String   @default("abierto") // abierto | en_proceso | resuelto | cerrado
  descripcion String
  creadoEn    DateTime @default(now())
}
